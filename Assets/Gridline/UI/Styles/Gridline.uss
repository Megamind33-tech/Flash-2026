/*
 * GRIDLINE UI — open-world crime-drama style (GTA V / FiveM conventions): flat square panels, translucent black,
 * white selection bar, condensed caps, green money, gold banners, minimal thin-outline touch controls.
 * Menu structure follows NativeUI's list-menu layout (MIT, see FORK_NOTICE.md); screen architecture from Unity Royale (MIT).
 * No Rockstar fonts, textures or logos: Bebas Neue + Barlow (OFL), Material Icons (Apache-2.0), GRIDLINE renders.
 * Reference resolution 1920x1080 (landscape).
 */

:root {
    --black: rgba(0, 0, 0, 0.72);
    --black-soft: rgba(0, 0, 0, 0.55);
    --black-solid: rgb(8, 8, 9);
    --white: rgb(255, 255, 255);
    --text: rgb(240, 240, 240);
    --muted: rgba(255, 255, 255, 0.62);
    --line: rgba(255, 255, 255, 0.14);
    --gold: rgb(240, 200, 80);
    --money: rgb(114, 204, 114);
    --blue: rgb(93, 160, 230);
    --red: rgb(224, 50, 50);
    --purple: rgb(178, 112, 255);
}

.gl-root {
    flex-grow: 1;
    -unity-font-definition: url("../Fonts/Barlow-Medium.ttf");
    color: var(--text);
    font-size: 30px;
}

/* ---------- type ---------- */
.f-display { -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); }
.f-cond { -unity-font-definition: url("../Fonts/BarlowCondensed-SemiBold.ttf"); }
.f-cond-bold { -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); }
.f-cond-xbold { -unity-font-definition: url("../Fonts/BarlowCondensed-ExtraBold.ttf"); }
.f-semi { -unity-font-definition: url("../Fonts/Barlow-SemiBold.ttf"); }
.shadow { text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.9); }
.t-muted { color: var(--muted); }
.t-money { color: var(--money); }
.t-gold { color: var(--gold); }
.t-red { color: var(--red); }
.t-blue { color: var(--blue); }
.t-purple { color: var(--purple); }
.caps { letter-spacing: 1px; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.hidden { display: none; }

/* ---------- icons (Material, white, tinted) ---------- */
.icon { width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--white); flex-shrink: 0; }
.icon--sm { width: 30px; height: 30px; }
.icon--lg { width: 60px; height: 60px; }
.icon--muted { -unity-background-image-tint-color: var(--muted); }
.icon--gold { -unity-background-image-tint-color: var(--gold); }
.ic-settings { background-image: url("../Icons/ic_tune.png"); }
.ic-back { background-image: url("../Icons/ic_arrow_back.png"); }
.ic-play { background-image: url("../Icons/ic_play_arrow.png"); }
.ic-pause { background-image: url("../Icons/ic_pause.png"); }
.ic-replay { background-image: url("../Icons/ic_replay.png"); }
.ic-home { background-image: url("../Icons/ic_home.png"); }
.ic-camera { background-image: url("../Icons/ic_videocam.png"); }
.ic-flag { background-image: url("../Icons/ic_sports_score.png"); }
.ic-trophy { background-image: url("../Icons/ic_emoji_events.png"); }
.ic-car { background-image: url("../Icons/ic_directions_car.png"); }
.ic-timer { background-image: url("../Icons/ic_timer.png"); }
.ic-speed { background-image: url("../Icons/ic_speed.png"); }
.ic-close { background-image: url("../Icons/ic_close.png"); }
.ic-left { background-image: url("../Icons/ic_chevron_left.png"); }
.ic-right { background-image: url("../Icons/ic_chevron_right.png"); }
.ic-money { background-image: url("../Icons/ic_payments.png"); }
.ic-star { background-image: url("../Icons/ic_star.png"); }
.ic-board { background-image: url("../Icons/ic_leaderboard.png"); }
.ic-driver { background-image: url("../Icons/ic_account_circle.png"); }
.ic-reset { background-image: url("../Icons/ic_settings_backup_restore.png"); }

/* ================= LIST MENU (NativeUI-style) ================= */
.nui { width: 760px; }
.nui__banner { height: 190px; background-color: var(--black-solid); -unity-background-scale-mode: scale-and-crop; justify-content: flex-end; padding: 0 30px 14px 30px; }
.nui__banner-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-image: url("../Textures/ramp_down.png"); -unity-background-image-tint-color: rgba(0, 0, 0, 0.85); }
.nui__title { font-size: 112px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); color: var(--white); margin-bottom: -22px; text-shadow: 3px 3px 4px rgba(0, 0, 0, 0.9); }
.nui__subtitle { flex-direction: row; align-items: center; height: 60px; padding: 0 26px; background-color: var(--black-solid); }
.nui__subtitle-text { flex-grow: 1; font-size: 28px; color: var(--blue); -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); letter-spacing: 1px; }
.nui__counter { font-size: 26px; color: var(--muted); -unity-font-definition: url("../Fonts/BarlowCondensed-SemiBold.ttf"); }
.nui__item {
    flex-direction: row;
    align-items: center;
    height: 84px;
    margin: 0;
    padding: 0 26px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--black);
    color: var(--text);
    font-size: 34px;
    -unity-font-definition: url("../Fonts/Barlow-SemiBold.ttf");
    -unity-text-align: middle-left;
}
.nui__item:hover { background-color: rgba(30, 30, 30, 0.85); }
.nui__item:active, .nui__item--selected { background-color: var(--white); color: rgb(10, 10, 10); }
.nui__item--selected .icon, .nui__item:active .icon { -unity-background-image-tint-color: rgb(10, 10, 10); }
.nui__item--selected .nui__value, .nui__item:active .nui__value { color: rgb(10, 10, 10); }
.nui__item--danger { color: rgb(255, 120, 120); }
.nui__label { flex-grow: 1; }
.nui__value { font-size: 32px; color: var(--text); -unity-font-definition: url("../Fonts/BarlowCondensed-SemiBold.ttf"); }
.nui__arrow { width: 34px; height: 34px; }
.nui__desc { background-color: var(--black); border-top-width: 4px; border-color: var(--black-solid); padding: 18px 26px 22px 26px; margin-top: 6px; }
.nui__desc-text { font-size: 28px; white-space: normal; color: var(--text); }

/* ---------- top-right player status (money + rep) ---------- */
.status { position: absolute; right: 48px; top: 40px; align-items: flex-end; }
.status__money { font-size: 76px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); color: var(--money); text-shadow: 3px 3px 3px rgba(0, 0, 0, 0.95); margin-bottom: -10px; }
.status__name { font-size: 30px; -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.9); }
.rep { flex-direction: row; align-items: center; margin-top: 8px; }
.rep__rank { width: 62px; height: 62px; border-radius: 31px; border-width: 4px; border-color: var(--blue); background-color: rgba(0, 0, 0, 0.75); align-items: center; justify-content: center; margin-left: 12px; }
.rep__rank-text { font-size: 30px; -unity-font-definition: url("../Fonts/BarlowCondensed-ExtraBold.ttf"); }
.rep__bar { width: 300px; height: 12px; background-color: rgba(0, 0, 0, 0.6); border-width: 1px; border-color: rgba(255, 255, 255, 0.25); }
.rep__fill { height: 100%; background-color: var(--blue); }
.rep__label { font-size: 22px; color: var(--muted); -unity-font-definition: url("../Fonts/BarlowCondensed-SemiBold.ttf"); margin-right: 12px; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }

.menu-root { padding: 48px 56px; }
.menu-footer { position: absolute; right: 48px; bottom: 30px; font-size: 20px; color: var(--muted); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }
.event-map { width: 180px; height: 130px; margin-left: 16px; flex-shrink: 0; }
.history-item { height: 72px; font-size: 28px; }

/* ================= RACE HUD ================= */
.hud-root { padding: 28px 40px; }

/* radar / minimap, top-left on mobile (thumbs own the bottom corners) */
.radar { position: absolute; left: 40px; top: 28px; width: 330px; }
.radar__map { height: 230px; background-color: rgba(0, 0, 0, 0.62); border-width: 3px; border-color: rgba(0, 0, 0, 0.9); }
.radar__bars { flex-direction: row; margin-top: 5px; }
.radar__bar { height: 12px; background-color: rgba(0, 0, 0, 0.7); flex-grow: 1; flex-basis: 0; }
.radar__bar--gap { margin-right: 5px; }
.radar__fill { height: 100%; }
.radar__fill--rpm { background-color: rgb(114, 204, 114); }
.radar__fill--rpm-high { background-color: var(--red); }
.radar__fill--pos { background-color: var(--blue); }

/* race info stack, top-right, GTA Online style */
.race-info { position: absolute; right: 40px; top: 28px; width: 520px; }
.info-row { flex-direction: row; align-items: center; height: 70px; margin-bottom: 6px; padding: 0 24px 0 90px; background-image: url("../Textures/ramp_right.png"); -unity-background-image-tint-color: rgba(0, 0, 0, 0.78); }
.info-row__label { flex-grow: 1; font-size: 28px; -unity-font-definition: url("../Fonts/BarlowCondensed-SemiBold.ttf"); color: var(--text); -unity-text-align: middle-right; margin-right: 22px; }
.info-row__value { font-size: 58px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); color: var(--white); -unity-text-align: middle-right; min-width: 190px; margin-bottom: -6px; }
.info-row__value--small { font-size: 44px; }

.board { position: absolute; right: 40px; top: 340px; width: 380px; }
.board__row { flex-direction: row; align-items: center; height: 44px; margin-bottom: 3px; padding-right: 14px; background-image: url("../Textures/ramp_right.png"); -unity-background-image-tint-color: rgba(0, 0, 0, 0.7); }
.board__pos { width: 44px; height: 44px; -unity-text-align: middle-center; font-size: 26px; -unity-font-definition: url("../Fonts/BarlowCondensed-ExtraBold.ttf"); background-color: rgba(0, 0, 0, 0.6); }
.board__swatch { width: 5px; height: 44px; margin-right: 12px; }
.board__name { flex-grow: 1; font-size: 26px; -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); }
.board__gap { font-size: 24px; color: var(--muted); -unity-font-definition: url("../Fonts/BarlowCondensed-SemiBold.ttf"); }
.board__row--player { -unity-background-image-tint-color: rgba(255, 255, 255, 0.92); }
.board__row--player .board__name, .board__row--player .board__gap { color: rgb(10, 10, 10); }

/* speedometer, bottom centre (FiveM style: no dial, big digits) */
.speedo { position: absolute; bottom: 34px; left: 0; right: 0; align-items: center; }
.speedo__row { flex-direction: row; align-items: flex-end; }
.speedo__speed { font-size: 132px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); color: var(--white); text-shadow: 3px 3px 4px rgba(0, 0, 0, 0.9); margin-bottom: -26px; }
.speedo__side { margin-left: 14px; margin-bottom: 4px; }
.speedo__gear { font-size: 60px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); color: var(--gold); text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.9); margin-bottom: -14px; }
.speedo__unit { font-size: 24px; -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); color: var(--muted); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }
.speedo__rpm { flex-direction: row; margin-top: 10px; }
.rpm-seg { width: 16px; height: 8px; margin: 0 2px; background-color: rgba(255, 255, 255, 0.18); }
.rpm-seg--on { background-color: var(--white); }
.rpm-seg--red { background-color: var(--red); }

/* big centre messages: countdown, FINAL LAP, penalties */
.big-message { position: absolute; left: 0; right: 0; top: 300px; align-items: center; }
.big-message__text { font-size: 150px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); color: var(--white); text-shadow: 4px 4px 6px rgba(0, 0, 0, 0.9); opacity: 0; scale: 1.25 1.25; transition-property: opacity, scale; transition-duration: 0.18s; }
.big-message__text--show { opacity: 1; scale: 1 1; }
.big-message__text--go { color: var(--money); }
.big-message__text--gold { color: var(--gold); }
.big-message__sub { font-size: 36px; -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.9); margin-top: -20px; }
.help { position: absolute; left: 40px; top: 300px; max-width: 520px; background-color: rgba(0, 0, 0, 0.8); padding: 14px 20px; font-size: 26px; white-space: normal; opacity: 0; transition-property: opacity; transition-duration: 0.2s; }
.help--show { opacity: 1; }

.hud-buttons { position: absolute; left: 0; right: 0; top: 28px; flex-direction: row; justify-content: center; }
.hud-btn { width: 92px; height: 72px; margin: 0 6px; padding: 0; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0.6); align-items: center; justify-content: center; }
.hud-btn:active { background-color: var(--white); }
.hud-btn:active .icon { -unity-background-image-tint-color: rgb(10, 10, 10); }
.fps { position: absolute; left: 40px; top: 290px; font-size: 22px; color: var(--muted); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }

/* touch controls: thin outlines, no heavy fills */
.pad { position: absolute; border-width: 2px; border-color: rgba(255, 255, 255, 0.55); background-color: rgba(0, 0, 0, 0.18); align-items: center; justify-content: center; transition-property: background-color, border-color; transition-duration: 0.05s; }
.pad .icon { width: 84px; height: 84px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.9); }
.pad__label { font-size: 26px; letter-spacing: 2px; color: rgba(255, 255, 255, 0.9); -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }
.pad--pressed { background-color: rgba(255, 255, 255, 0.35); border-color: var(--white); }
.pad--steer-left { left: 50px; bottom: 50px; width: 230px; height: 230px; border-radius: 115px; }
.pad--steer-right { left: 310px; bottom: 50px; width: 230px; height: 230px; border-radius: 115px; }
.pad--brake { right: 320px; bottom: 50px; width: 200px; height: 250px; border-radius: 22px; }
.pad--throttle { right: 60px; bottom: 50px; width: 220px; height: 340px; border-radius: 22px; }
.pad--throttle.pad--pressed { background-color: rgba(114, 204, 114, 0.4); border-color: var(--money); }
.pad--brake.pad--pressed { background-color: rgba(224, 50, 50, 0.4); border-color: var(--red); }
.pad--shift-up { right: 60px; bottom: 420px; width: 110px; height: 100px; border-radius: 16px; }
.pad--shift-down { right: 190px; bottom: 420px; width: 110px; height: 100px; border-radius: 16px; }
.pad--shift-up .pad__label, .pad--shift-down .pad__label { font-size: 52px; letter-spacing: 0; }

/* overlays */
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); padding: 60px 70px; }
.overlay--center { align-items: center; justify-content: center; }

/* results: GTA-style leaderboard + rewards */
.res-title { font-size: 140px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); color: var(--gold); text-shadow: 4px 4px 6px rgba(0, 0, 0, 0.95); -unity-text-align: middle-center; margin-bottom: -26px; }
.res-sub { font-size: 34px; -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); -unity-text-align: middle-center; text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.9); margin-bottom: 26px; }
.res-body { flex-direction: row; justify-content: center; }
.res-table { width: 1080px; }
.res-head { flex-direction: row; height: 52px; align-items: center; background-color: var(--black-solid); padding: 0 22px; }
.res-head .res-cell { font-size: 24px; color: var(--muted); -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); }
.res-row { flex-direction: row; height: 70px; align-items: center; background-color: var(--black); padding: 0 22px; margin-top: 3px; }
.res-row--player { background-color: rgba(255, 255, 255, 0.92); color: rgb(10, 10, 10); }
.res-row--player .res-team { color: rgba(0, 0, 0, 0.6); }
.res-cell { font-size: 32px; -unity-font-definition: url("../Fonts/BarlowCondensed-SemiBold.ttf"); }
.res-pos { width: 80px; font-size: 40px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); }
.res-name { flex-grow: 1; flex-direction: row; align-items: center; }
.res-team { font-size: 24px; color: var(--muted); margin-left: 16px; }
.res-time { width: 220px; -unity-text-align: middle-right; }
.res-best { width: 230px; -unity-text-align: middle-right; flex-direction: row; justify-content: flex-end; align-items: center; }
.res-best--fastest { color: var(--purple); }
.rewards { width: 520px; margin-left: 24px; }
.rewards__head { height: 52px; background-color: var(--black-solid); padding: 0 22px; justify-content: center; font-size: 24px; color: var(--muted); -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); }
.reward-line { flex-direction: row; justify-content: space-between; align-items: center; height: 62px; background-color: var(--black); padding: 0 22px; margin-top: 3px; }
.reward-line__label { font-size: 28px; }
.reward-line__amount { font-size: 40px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); }
.reward-total { flex-direction: row; justify-content: space-between; align-items: center; height: 96px; background-color: var(--black-solid); padding: 0 22px; margin-top: 3px; }
.reward-total__amount { font-size: 72px; -unity-font-definition: url("../Fonts/BebasNeue-Regular.ttf"); color: var(--money); margin-bottom: -10px; }

/* instructional buttons, bottom-right like GTA's prompt bar (tappable) */
.prompts { position: absolute; right: 60px; bottom: 50px; flex-direction: row; }
.prompt { flex-direction: row; align-items: center; height: 76px; margin-left: 12px; padding: 0 26px 0 14px; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0.8); color: var(--text); font-size: 30px; -unity-font-definition: url("../Fonts/BarlowCondensed-Bold.ttf"); }
.prompt__key { width: 48px; height: 48px; margin-right: 14px; background-color: var(--white); align-items: center; justify-content: center; }
.prompt__key .icon { width: 34px; height: 34px; -unity-background-image-tint-color: rgb(10, 10, 10); }
.prompt:active { background-color: var(--white); color: rgb(10, 10, 10); }
