/*
 * GRIDLINE design system (UI Toolkit / USS).
 * Screen architecture forked from Unity Technologies' UI Toolkit "Unity Royale" runtime demo (MIT, see FORK_NOTICE.md);
 * visual language is GRIDLINE's own motorsport-broadcast style: carbon panels, racing red, amber highlights, Titillium Web.
 * Reference resolution 1920x1080 (landscape).
 */

:root {
    --c-bg: rgb(9, 11, 15);
    --c-panel: rgba(13, 16, 22, 0.90);
    --c-panel-2: rgba(22, 26, 34, 0.94);
    --c-panel-3: rgba(32, 37, 47, 0.96);
    --c-line: rgba(255, 255, 255, 0.09);
    --c-text: rgb(243, 245, 248);
    --c-muted: rgb(150, 159, 175);
    --c-red: rgb(225, 16, 30);
    --c-red-dark: rgb(150, 8, 18);
    --c-amber: rgb(255, 184, 0);
    --c-green: rgb(46, 204, 113);
    --c-purple: rgb(170, 90, 255);
    --radius: 6px;
}

.gl-root {
    flex-grow: 1;
    -unity-font-definition: url("../Fonts/TitilliumWeb-SemiBold.ttf");
    color: var(--c-text);
    font-size: 30px;
}

/* ---------- typography ---------- */
.t-black { -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); }
.t-bold { -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf"); }
.t-italic { -unity-font-definition: url("../Fonts/TitilliumWeb-BoldItalic.ttf"); }
.t-regular { -unity-font-definition: url("../Fonts/TitilliumWeb-Regular.ttf"); }
.t-caps { letter-spacing: 3px; }
.t-muted { color: var(--c-muted); }
.t-amber { color: var(--c-amber); }
.t-green { color: var(--c-green); }
.t-red { color: var(--c-red); }
.t-label { font-size: 22px; letter-spacing: 3px; color: var(--c-muted); -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf"); }
.t-shadow { text-shadow: 0 2px 6px rgba(0, 0, 0, 0.75); }

/* ---------- surfaces ---------- */
.panel {
    background-color: var(--c-panel);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--c-line);
    padding: 24px 28px;
}
.panel--flat { background-color: var(--c-panel-2); }
.accent-bar { width: 6px; background-color: var(--c-red); border-radius: 3px; margin-right: 18px; }
.accent-bar--amber { background-color: var(--c-amber); }
.divider { height: 1px; background-color: var(--c-line); margin: 18px 0; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.hidden { display: none; }

/* ---------- icons (Material icons, white, tinted by colour) ---------- */
.icon { width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--c-text); flex-shrink: 0; }
.icon--sm { width: 30px; height: 30px; }
.icon--lg { width: 56px; height: 56px; }
.icon--muted { -unity-background-image-tint-color: var(--c-muted); }
.icon--amber { -unity-background-image-tint-color: var(--c-amber); }
.icon--dark { -unity-background-image-tint-color: rgb(12, 12, 14); }
.ic-settings { background-image: url("../Icons/ic_tune.png"); }
.ic-back { background-image: url("../Icons/ic_arrow_back.png"); }
.ic-play { background-image: url("../Icons/ic_play_arrow.png"); }
.ic-pause { background-image: url("../Icons/ic_pause.png"); }
.ic-replay { background-image: url("../Icons/ic_replay.png"); }
.ic-home { background-image: url("../Icons/ic_home.png"); }
.ic-camera { background-image: url("../Icons/ic_videocam.png"); }
.ic-flag { background-image: url("../Icons/ic_sports_score.png"); }
.ic-trophy { background-image: url("../Icons/ic_emoji_events.png"); }
.ic-car { background-image: url("../Icons/ic_directions_car.png"); }
.ic-timer { background-image: url("../Icons/ic_timer.png"); }
.ic-speed { background-image: url("../Icons/ic_speed.png"); }
.ic-tilt { background-image: url("../Icons/ic_screen_rotation.png"); }
.ic-touch { background-image: url("../Icons/ic_touch_app.png"); }
.ic-close { background-image: url("../Icons/ic_close.png"); }
.ic-check { background-image: url("../Icons/ic_check.png"); }
.ic-left { background-image: url("../Icons/ic_chevron_left.png"); }
.ic-right { background-image: url("../Icons/ic_chevron_right.png"); }
.ic-money { background-image: url("../Icons/ic_payments.png"); }
.ic-star { background-image: url("../Icons/ic_star.png"); }
.ic-trend { background-image: url("../Icons/ic_trending_up.png"); }
.ic-board { background-image: url("../Icons/ic_leaderboard.png"); }
.ic-driver { background-image: url("../Icons/ic_account_circle.png"); }
.ic-lock { background-image: url("../Icons/ic_lock.png"); }
.ic-reset { background-image: url("../Icons/ic_settings_backup_restore.png"); }

/* ---------- buttons ---------- */
.gl-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 96px;
    padding: 0 30px;
    margin: 0;
    border-width: 1px;
    border-color: var(--c-line);
    border-radius: var(--radius);
    background-color: var(--c-panel-3);
    color: var(--c-text);
    font-size: 32px;
    letter-spacing: 2px;
    -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf");
    transition-property: scale, background-color, border-color;
    transition-duration: 0.08s, 0.12s, 0.12s;
}
.gl-btn:hover { background-color: rgb(42, 48, 60); border-color: rgba(255, 255, 255, 0.18); }
.gl-btn:active { scale: 0.97 0.97; background-color: rgb(52, 59, 73); }
.gl-btn .icon { margin-right: 16px; }
.gl-btn--primary { background-color: var(--c-red); border-color: rgb(255, 70, 80); }
.gl-btn--primary:hover { background-color: rgb(240, 30, 44); border-color: rgb(255, 110, 118); }
.gl-btn--primary:active { background-color: var(--c-red-dark); }
.gl-btn--danger { border-color: rgba(225, 16, 30, 0.6); color: rgb(255, 120, 126); }
.gl-btn--icon { width: 104px; height: 104px; padding: 0; }
.gl-btn--icon .icon { margin-right: 0; }
.gl-btn--hero { height: 120px; font-size: 46px; letter-spacing: 6px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); }

/* ---------- chips & segmented controls ---------- */
.chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--c-panel-2);
    border-radius: 999px;
    border-width: 1px;
    border-color: var(--c-line);
    padding: 8px 22px 8px 14px;
    margin-right: 12px;
}
.chip .icon { margin-right: 10px; }
.chip__value { font-size: 30px; -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf"); }

.segmented { flex-direction: row; background-color: var(--c-panel-2); border-radius: var(--radius); border-width: 1px; border-color: var(--c-line); padding: 6px; }
.segment {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    height: 76px;
    margin: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-muted);
    font-size: 26px;
    letter-spacing: 2px;
    -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf");
    align-items: center;
    justify-content: center;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}
.segment .icon { margin-right: 10px; -unity-background-image-tint-color: var(--c-muted); }
.segment--on { background-color: var(--c-red); color: var(--c-text); }
.segment--on .icon { -unity-background-image-tint-color: var(--c-text); }

/* ---------- slider ---------- */
.gl-slider { margin: 6px 0 0 0; height: 70px; }
.gl-slider .unity-base-slider__tracker { height: 10px; margin-top: -5px; border-radius: 5px; background-color: var(--c-panel-3); border-width: 0; }
.gl-slider .unity-base-slider__dragger-border { display: none; }
.gl-slider .unity-base-slider__dragger { width: 46px; height: 46px; margin-top: -23px; border-radius: 23px; background-color: var(--c-text); border-width: 4px; border-color: var(--c-red); }
.gl-slider .unity-base-slider__drag-container { height: 70px; }

/* ================= MAIN MENU ================= */
.menu-root { flex-direction: row; padding: 40px 48px; }
.menu-left { width: 860px; justify-content: space-between; }
.brand { flex-direction: row; align-items: stretch; }
.brand__word { font-size: 112px; letter-spacing: 8px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); margin: -18px 0 -22px -4px; }
.brand__tag { font-size: 30px; letter-spacing: 12px; color: var(--c-muted); -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf"); }
.driver-card { margin-top: 26px; }
.driver-card__name { font-size: 46px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); letter-spacing: 2px; }
.driver-card__rank { font-size: 24px; letter-spacing: 3px; color: var(--c-amber); -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf"); }
.stat-grid { flex-direction: row; margin-top: 18px; }
.stat { flex-grow: 1; flex-basis: 0; background-color: var(--c-panel-2); border-radius: var(--radius); padding: 14px 18px; margin-right: 12px; border-width: 1px; border-color: var(--c-line); }
.stat--last { margin-right: 0; }
.stat__value { font-size: 44px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); }
.event-card { margin-top: 22px; }
.event-card__name { font-size: 48px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); letter-spacing: 1px; }
.event-card__track { font-size: 28px; color: var(--c-muted); }
.event-meta { flex-direction: row; margin: 16px 0 20px 0; }
.event-body { flex-direction: row; }
.event-map { width: 230px; height: 170px; margin-left: 16px; flex-shrink: 0; background-color: rgba(0, 0, 0, 0.25); border-radius: var(--radius); }
.menu-right { flex-grow: 1; align-items: flex-end; justify-content: space-between; }
.menu-actions { flex-direction: row; }
.menu-actions .gl-btn { margin-left: 16px; }
.menu-version { font-size: 20px; color: var(--c-muted); }

.sheet-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.55); align-items: flex-end; }
.sheet { width: 880px; height: 100%; background-color: rgba(11, 13, 18, 0.98); border-left-width: 1px; border-color: var(--c-line); padding: 44px 48px; }
.sheet__header { flex-direction: row; align-items: center; margin-bottom: 26px; }
.sheet__title { font-size: 54px; flex-grow: 1; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); letter-spacing: 3px; }
.setting { margin-bottom: 26px; }
.setting__label { margin-bottom: 10px; }
.history-row { flex-direction: row; align-items: center; padding: 14px 6px; border-bottom-width: 1px; border-color: var(--c-line); }
.history-row__pos { width: 90px; font-size: 34px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); }
.history-row__main { flex-grow: 1; }
.history-row__money { font-size: 30px; -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf"); }

.modal-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.72); align-items: center; justify-content: center; }
.modal { width: 760px; }
.modal__title { font-size: 48px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); letter-spacing: 3px; margin-bottom: 12px; }
.modal__body { font-size: 30px; color: var(--c-muted); white-space: normal; margin-bottom: 30px; }
.modal__actions { flex-direction: row; }
.modal__actions .gl-btn { flex-grow: 1; flex-basis: 0; }
.modal__actions .gl-btn--spaced { margin-right: 16px; }

/* ================= RACE HUD ================= */
.hud-root { padding: 28px 36px; }
.hud-top { flex-direction: row; align-items: flex-start; }

.tower { width: 420px; background-color: var(--c-panel); border-radius: var(--radius); border-width: 1px; border-color: var(--c-line); overflow: hidden; }
.tower__head { flex-direction: row; align-items: center; background-color: var(--c-red); padding: 8px 18px; }
.tower__lap { font-size: 34px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); letter-spacing: 2px; }
.tower__row { flex-direction: row; align-items: center; height: 54px; padding-right: 16px; border-bottom-width: 1px; border-color: var(--c-line); }
.tower__pos { width: 52px; height: 54px; -unity-text-align: middle-center; font-size: 28px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); background-color: rgba(255, 255, 255, 0.06); }
.tower__swatch { width: 6px; height: 34px; margin: 0 14px 0 10px; border-radius: 2px; }
.tower__name { flex-grow: 1; font-size: 28px; letter-spacing: 2px; -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf"); }
.tower__gap { font-size: 26px; color: var(--c-muted); }
.tower__row--player { background-color: rgba(255, 184, 0, 0.16); }
.tower__row--player .tower__name { color: var(--c-amber); }

.timing { margin-left: 24px; padding: 14px 30px 16px 30px; align-items: center; min-width: 420px; }
.timing__current { font-size: 64px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); letter-spacing: 2px; margin: -8px 0 -6px 0; }
.timing__row { flex-direction: row; align-items: center; }
.timing__best { font-size: 26px; color: var(--c-muted); }
.timing__penalty { font-size: 26px; color: var(--c-red); margin-left: 16px; }
.timing__pos { font-size: 22px; letter-spacing: 3px; color: var(--c-muted); }

.hud-map { width: 270px; height: 200px; margin-left: 24px; }
.hud-buttons { flex-grow: 1; flex-direction: row; justify-content: flex-end; }
.hud-buttons .gl-btn { margin-left: 16px; background-color: var(--c-panel); }

.notice { position: absolute; top: 230px; left: 0; right: 0; align-items: center; }
.notice__pill { background-color: rgba(10, 12, 16, 0.92); border-radius: var(--radius); border-left-width: 6px; border-color: var(--c-amber); padding: 12px 36px; font-size: 40px; letter-spacing: 3px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); opacity: 0; translate: 0 -20px; transition-property: opacity, translate; transition-duration: 0.18s; }
.notice__pill--show { opacity: 1; translate: 0 0; }

.lights { position: absolute; top: 300px; left: 0; right: 0; align-items: center; }
.lights__frame { flex-direction: row; background-color: rgb(14, 15, 18); border-radius: 12px; padding: 18px 22px; border-width: 2px; border-color: rgb(40, 42, 48); }
.light { width: 96px; height: 96px; border-radius: 48px; margin: 0 10px; background-color: rgb(46, 10, 12); border-width: 4px; border-color: rgb(24, 24, 28); transition-property: background-color; transition-duration: 0.06s; }
.light--on { background-color: rgb(255, 26, 36); }
.light--go { background-color: var(--c-green); }

.dash { position: absolute; bottom: 30px; left: 0; right: 0; align-items: center; }
.gauge { width: 330px; height: 250px; align-items: center; justify-content: flex-end; padding-bottom: 18px; }
.gauge__speed { font-size: 96px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); margin-bottom: -26px; }
.gauge__unit { font-size: 22px; letter-spacing: 4px; color: var(--c-muted); }
.gauge__gear { position: absolute; top: 36px; font-size: 44px; color: var(--c-amber); -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); }

.fps { position: absolute; right: 36px; top: 150px; font-size: 22px; color: var(--c-muted); }

/* touch controls */
.pad { position: absolute; background-color: rgba(10, 12, 16, 0.42); border-width: 2px; border-color: rgba(255, 255, 255, 0.22); border-radius: 26px; align-items: center; justify-content: center; transition-property: background-color, border-color, scale; transition-duration: 0.05s; }
.pad .icon { width: 96px; height: 96px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.9); }
.pad__label { font-size: 26px; letter-spacing: 4px; color: rgba(255, 255, 255, 0.85); -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); margin-top: 6px; }
.pad--pressed { background-color: rgba(225, 16, 30, 0.55); border-color: rgb(255, 90, 98); scale: 0.97 0.97; }
.pad--steer-left { left: 44px; bottom: 44px; width: 260px; height: 260px; }
.pad--steer-right { left: 330px; bottom: 44px; width: 260px; height: 260px; }
.pad--brake { right: 330px; bottom: 44px; width: 230px; height: 270px; }
.pad--throttle { right: 44px; bottom: 44px; width: 260px; height: 360px; }
.pad--throttle.pad--pressed { background-color: rgba(46, 204, 113, 0.5); border-color: rgb(110, 240, 160); }
.pad--shift-up { right: 44px; bottom: 430px; width: 120px; height: 110px; }
.pad--shift-down { right: 184px; bottom: 430px; width: 120px; height: 110px; }
.pad--shift-up .pad__label, .pad--shift-down .pad__label { font-size: 48px; margin-top: 0; }

/* pause & results overlays */
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(4, 5, 8, 0.78); align-items: center; justify-content: center; }
.pause-card { width: 720px; }
.pause-card .gl-btn { margin-top: 16px; justify-content: flex-start; }

.results { flex-direction: row; width: 1720px; }
.results__table { flex-grow: 1; margin-right: 24px; }
.results__title { font-size: 56px; letter-spacing: 3px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); }
.results__sub { font-size: 26px; color: var(--c-muted); letter-spacing: 3px; margin-bottom: 18px; }
.res-row { flex-direction: row; align-items: center; height: 88px; border-bottom-width: 1px; border-color: var(--c-line); }
.res-row--head { height: 50px; }
.res-row--player { background-color: rgba(255, 184, 0, 0.14); }
.res-pos { width: 90px; height: 88px; -unity-text-align: middle-center; font-size: 40px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); }
.res-pos--p1 { color: var(--c-amber); }
.res-name { flex-grow: 1; font-size: 32px; -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf"); }
.res-team { font-size: 22px; color: var(--c-muted); }
.res-time { width: 260px; font-size: 30px; -unity-text-align: middle-right; }
.res-best { width: 280px; font-size: 30px; -unity-text-align: middle-right; flex-direction: row; justify-content: flex-end; align-items: center; }
.res-best--fastest { color: var(--c-purple); }
.reward { width: 560px; }
.reward__line { flex-direction: row; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom-width: 1px; border-color: var(--c-line); }
.reward__amount { font-size: 34px; -unity-font-definition: url("../Fonts/TitilliumWeb-Bold.ttf"); }
.reward__total { font-size: 58px; -unity-font-definition: url("../Fonts/TitilliumWeb-Black.ttf"); }
.reward .gl-btn { margin-top: 16px; }
