<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Styles/Gridline.uss" />
    <ui:VisualElement name="hud" class="gl-root hud-root" picking-mode="Ignore">
        <ui:VisualElement class="radar" picking-mode="Ignore">
            <ui:VisualElement name="hud-map" class="radar__map" picking-mode="Ignore" />
            <ui:VisualElement class="radar__bars" picking-mode="Ignore">
                <ui:VisualElement class="radar__bar radar__bar--gap" picking-mode="Ignore"><ui:VisualElement name="rpm-fill" class="radar__fill radar__fill--rpm" style="width: 0%;" /></ui:VisualElement>
                <ui:VisualElement class="radar__bar" picking-mode="Ignore"><ui:VisualElement name="progress-fill" class="radar__fill radar__fill--pos" style="width: 0%;" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="fps" text="" class="fps" />

        <ui:VisualElement class="race-info" picking-mode="Ignore">
            <ui:VisualElement class="info-row" picking-mode="Ignore"><ui:Label text="POSITION" class="info-row__label" /><ui:Label name="position" text="5/5" class="info-row__value" /></ui:VisualElement>
            <ui:VisualElement class="info-row" picking-mode="Ignore"><ui:Label text="LAP" class="info-row__label" /><ui:Label name="lap" text="1/3" class="info-row__value" /></ui:VisualElement>
            <ui:VisualElement class="info-row" picking-mode="Ignore"><ui:Label text="TIME" class="info-row__label" /><ui:Label name="lap-time" text="00:00.00" class="info-row__value info-row__value--small" /></ui:VisualElement>
            <ui:VisualElement class="info-row" picking-mode="Ignore"><ui:Label text="BEST LAP" class="info-row__label" /><ui:Label name="best-lap" text="--:--.--" class="info-row__value info-row__value--small" /></ui:VisualElement>
            <ui:VisualElement name="penalty-row" class="info-row hidden" picking-mode="Ignore"><ui:Label text="PENALTY" class="info-row__label t-red" /><ui:Label name="penalty" text="" class="info-row__value info-row__value--small t-red" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="tower-rows" class="board" picking-mode="Ignore" />

        <ui:VisualElement class="hud-buttons" picking-mode="Ignore">
            <ui:Button name="camera-button" class="hud-btn"><ui:VisualElement class="icon ic-camera" /></ui:Button>
            <ui:Button name="pause-button" class="hud-btn"><ui:VisualElement class="icon ic-pause" /></ui:Button>
        </ui:VisualElement>

        <ui:VisualElement class="big-message" picking-mode="Ignore">
            <ui:Label name="big-text" text="" class="big-message__text" />
            <ui:Label name="big-sub" text="" class="big-message__sub" />
        </ui:VisualElement>
        <ui:Label name="notice" text="" class="help" picking-mode="Ignore" />

        <ui:VisualElement class="speedo" picking-mode="Ignore">
            <ui:VisualElement class="speedo__row" picking-mode="Ignore">
                <ui:Label name="speed" text="0" class="speedo__speed" />
                <ui:VisualElement class="speedo__side" picking-mode="Ignore">
                    <ui:Label name="gear" text="N" class="speedo__gear" />
                    <ui:Label text="KM/H" class="speedo__unit" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="rpm" class="speedo__rpm" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="controls" picking-mode="Ignore" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0;">
            <ui:VisualElement name="pad-left" class="pad pad--steer-left" picking-mode="Ignore"><ui:VisualElement class="icon ic-left" /></ui:VisualElement>
            <ui:VisualElement name="pad-right" class="pad pad--steer-right" picking-mode="Ignore"><ui:VisualElement class="icon ic-right" /></ui:VisualElement>
            <ui:VisualElement name="pad-brake" class="pad pad--brake" picking-mode="Ignore"><ui:Label text="BRAKE" class="pad__label" /></ui:VisualElement>
            <ui:VisualElement name="pad-throttle" class="pad pad--throttle" picking-mode="Ignore"><ui:VisualElement class="icon ic-speed" /><ui:Label text="GAS" class="pad__label" /></ui:VisualElement>
            <ui:VisualElement name="pad-up" class="pad pad--shift-up hidden" picking-mode="Ignore"><ui:Label text="+" class="pad__label" /></ui:VisualElement>
            <ui:VisualElement name="pad-down" class="pad pad--shift-down hidden" picking-mode="Ignore"><ui:Label text="−" class="pad__label" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="pause" class="overlay overlay--center hidden">
            <ui:VisualElement class="nui">
                <ui:VisualElement class="nui__subtitle"><ui:Label text="PAUSE MENU" class="nui__subtitle-text" /><ui:Label name="pause-info" text="" class="nui__counter" /></ui:VisualElement>
                <ui:Button name="resume" class="nui__item nui__item--selected"><ui:Label text="Resume" class="nui__label" /></ui:Button>
                <ui:Button name="restart" class="nui__item"><ui:Label text="Restart Race" class="nui__label" /></ui:Button>
                <ui:Button name="pause-camera" class="nui__item"><ui:Label text="Change Camera" class="nui__label" /></ui:Button>
                <ui:Button name="retire" class="nui__item nui__item--danger"><ui:Label text="Retire to Menu" class="nui__label" /></ui:Button>
                <ui:VisualElement class="nui__desc"><ui:Label text="Retiring forfeits the entry fee. Restarting keeps it." class="nui__desc-text" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="results" class="overlay hidden">
            <ui:Label name="results-title" text="RACE COMPLETE" class="res-title" />
            <ui:Label name="results-sub" text="" class="res-sub" />
            <ui:VisualElement class="res-body">
                <ui:VisualElement class="res-table">
                    <ui:VisualElement class="res-head">
                        <ui:Label text="POS" class="res-cell res-pos" style="font-size: 24px;" />
                        <ui:Label text="DRIVER" class="res-cell res-name" />
                        <ui:Label text="TIME" class="res-cell res-time" />
                        <ui:Label text="BEST LAP" class="res-cell res-best" />
                    </ui:VisualElement>
                    <ui:VisualElement name="results-rows" />
                </ui:VisualElement>
                <ui:VisualElement class="rewards">
                    <ui:Label text="REWARDS" class="rewards__head" />
                    <ui:VisualElement name="reward-lines" />
                    <ui:VisualElement class="reward-total">
                        <ui:Label text="BANK" class="reward-line__label t-muted" />
                        <ui:Label name="reward-balance" text="$0" class="reward-total__amount" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="prompts">
                <ui:Button name="race-again" class="prompt"><ui:VisualElement class="prompt__key"><ui:VisualElement class="icon ic-replay" /></ui:VisualElement><ui:Label text="RACE AGAIN" /></ui:Button>
                <ui:Button name="continue" class="prompt"><ui:VisualElement class="prompt__key"><ui:VisualElement class="icon ic-play" /></ui:VisualElement><ui:Label text="CONTINUE" /></ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
