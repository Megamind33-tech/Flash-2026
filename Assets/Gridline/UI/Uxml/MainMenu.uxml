<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Styles/Gridline.uss" />
    <ui:VisualElement name="menu" class="gl-root menu-root">
        <ui:VisualElement name="nui" class="nui">
            <ui:VisualElement name="nui-banner" class="nui__banner" style="background-image: url('../Textures/menu_banner.jpg');">
                <ui:VisualElement class="nui__banner-shade" picking-mode="Ignore" />
                <ui:Label text="GRIDLINE" class="nui__title" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="nui__subtitle">
                <ui:Label name="nui-subtitle" text="THE RACING LEAGUE" class="nui__subtitle-text" />
                <ui:Label name="nui-counter" text="1/3" class="nui__counter" />
            </ui:VisualElement>

            <ui:VisualElement name="page-main">
                <ui:Button name="race-button" class="nui__item nui__item--selected">
                    <ui:Label text="Enter Race" class="nui__label" />
                    <ui:Label name="race-fee" text="$250" class="nui__value" />
                </ui:Button>
                <ui:Button name="career-button" class="nui__item">
                    <ui:Label text="Career" class="nui__label" />
                    <ui:VisualElement class="icon nui__arrow ic-right" />
                </ui:Button>
                <ui:Button name="settings-button" class="nui__item">
                    <ui:Label text="Settings" class="nui__label" />
                    <ui:VisualElement class="icon nui__arrow ic-right" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="page-settings" class="hidden">
                <ui:Button name="opt-steering" class="nui__item"><ui:Label text="Steering" class="nui__label" /><ui:VisualElement class="icon nui__arrow ic-left" /><ui:Label name="opt-steering-value" text="Touch" class="nui__value" /><ui:VisualElement class="icon nui__arrow ic-right" /></ui:Button>
                <ui:VisualElement class="nui__item">
                    <ui:Label text="Steering Sensitivity" class="nui__label" />
                    <ui:Button name="sens-down" class="hud-btn" style="width: 64px; height: 64px; background-color: rgba(0,0,0,0);"><ui:VisualElement class="icon nui__arrow ic-left" /></ui:Button>
                    <ui:Label name="sensitivity-value" text="1.0" class="nui__value" style="min-width: 54px; -unity-text-align: middle-center;" />
                    <ui:Button name="sens-up" class="hud-btn" style="width: 64px; height: 64px; background-color: rgba(0,0,0,0);"><ui:VisualElement class="icon nui__arrow ic-right" /></ui:Button>
                </ui:VisualElement>
                <ui:Button name="opt-gearbox" class="nui__item"><ui:Label text="Gearbox" class="nui__label" /><ui:VisualElement class="icon nui__arrow ic-left" /><ui:Label name="opt-gearbox-value" text="Automatic" class="nui__value" /><ui:VisualElement class="icon nui__arrow ic-right" /></ui:Button>
                <ui:Button name="opt-graphics" class="nui__item"><ui:Label text="Graphics" class="nui__label" /><ui:VisualElement class="icon nui__arrow ic-left" /><ui:Label name="opt-graphics-value" text="Medium" class="nui__value" /><ui:VisualElement class="icon nui__arrow ic-right" /></ui:Button>
                <ui:Button name="opt-fps" class="nui__item"><ui:Label text="Frame Rate Counter" class="nui__label" /><ui:VisualElement class="icon nui__arrow ic-left" /><ui:Label name="opt-fps-value" text="Off" class="nui__value" /><ui:VisualElement class="icon nui__arrow ic-right" /></ui:Button>
                <ui:Button name="reset-career" class="nui__item nui__item--danger"><ui:Label text="Reset Career" class="nui__label" /></ui:Button>
                <ui:Button name="settings-back" class="nui__item"><ui:VisualElement class="icon nui__arrow ic-back" style="margin-right: 14px;" /><ui:Label text="Back" class="nui__label" /></ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="page-career" class="hidden">
                <ui:VisualElement class="nui__item"><ui:Label text="Races" class="nui__label" /><ui:Label name="stat-races" text="0" class="nui__value" /></ui:VisualElement>
                <ui:VisualElement class="nui__item"><ui:Label text="Wins / Podiums" class="nui__label" /><ui:Label name="stat-wins" text="0 / 0" class="nui__value" /></ui:VisualElement>
                <ui:VisualElement class="nui__item"><ui:Label text="Championship Points" class="nui__label" /><ui:Label name="stat-points" text="0" class="nui__value" /></ui:VisualElement>
                <ui:VisualElement class="nui__item"><ui:Label text="Best Lap · Ashford" class="nui__label" /><ui:Label name="stat-best" text="--:--.---" class="nui__value" /></ui:VisualElement>
                <ui:ScrollView name="history" style="max-height: 300px;" />
                <ui:Button name="career-back" class="nui__item"><ui:VisualElement class="icon nui__arrow ic-back" style="margin-right: 14px;" /><ui:Label text="Back" class="nui__label" /></ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="page-confirm" class="hidden">
                <ui:Button name="confirm-ok" class="nui__item nui__item--danger"><ui:Label text="Yes, reset my career" class="nui__label" /></ui:Button>
                <ui:Button name="confirm-cancel" class="nui__item nui__item--selected"><ui:Label text="Cancel" class="nui__label" /></ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="nui-desc" class="nui__desc row">
                <ui:Label name="nui-desc-text" text="" class="nui__desc-text grow" />
                <ui:VisualElement name="event-map" class="event-map" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="status" picking-mode="Ignore">
            <ui:Label name="status-money" text="$0" class="status__money" />
            <ui:Label name="status-name" text="ROOKIE" class="status__name" />
            <ui:VisualElement class="rep">
                <ui:Label text="REPUTATION" class="rep__label" />
                <ui:VisualElement class="rep__bar"><ui:VisualElement name="rep-fill" class="rep__fill" style="width: 0%;" /></ui:VisualElement>
                <ui:VisualElement class="rep__rank"><ui:Label name="rep-rank" text="1" class="rep__rank-text" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="version" text="v0.1.0" class="menu-footer" />
    </ui:VisualElement>
</ui:UXML>
